# Journey of Grace - form submission relay environment
# Copy to api/.env and fill in. api/.env is gitignored (never commit real tokens).
#
# Planning Center Personal Access Token (client_id + secret pair).
# Generate at https://developer.planning.center (developer account).
# The token is read ONLY by the server-side api/relay.mjs container; it is
# NEVER sent to the browser or embedded in static site files.
PCO_CLIENT_ID=
PCO_SECRET=
# Comma-separated allowlist of form ids this relay will accept
# (e.g. the Connection Card form: 1242125). Required - prevents open proxy.
PCO_FORM_ID=1242125
# Listen port inside the container (mapped to host 3001 in docker-compose.yml).
PORT=3000
# Optional CORS allow-origin. Leave empty for * (public form endpoint).
ALLOWED_ORIGIN=
# Set to 1 for local dry-run WITHOUT touching Planning Center.
MOCK=0
